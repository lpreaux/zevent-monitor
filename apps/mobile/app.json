{
  "expo": {
    "name": "ZEvent Monitor",
    "slug": "zevent-monitor",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "zevent-monitor",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8b5cf6",
          "defaultChannel": "alerts"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "app.zeventmonitor.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3b1d78"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebf08712-898e-4a59-903b-9eb4ff6a3ac9"
      }
    },
    "owner": "lpreaux",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ebf08712-898e-4a59-903b-9eb4ff6a3ac9"
    },
    "ios": {}
  }
}
