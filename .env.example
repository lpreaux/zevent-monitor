POSTGRES_DB=zevent
POSTGRES_USER=zevent
POSTGRES_PASSWORD=replace-with-a-long-random-password
# SERVER_PORT n'a d'effet qu'en local, via docker-compose.override.yml (ignoré par Dockploy).
SERVER_PORT=3000
LOG_LEVEL=info
COLLECTOR_ENABLED=true
COLLECT_INTERVAL_MS=15000
GOALS_SYNC_ENABLED=true
GOALS_SYNC_INTERVAL_MS=300000
