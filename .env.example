POSTGRES_DB=zevent
POSTGRES_USER=zevent
POSTGRES_PASSWORD=replace-with-a-long-random-password
# API_PORT n'a d'effet qu'en local, via docker-compose.override.yml (ignoré par Dockploy).
API_PORT=3000
LOG_LEVEL=info
COLLECTOR_ENABLED=true
COLLECT_INTERVAL_MS=15000
GOALS_SYNC_ENABLED=true
GOALS_SYNC_INTERVAL_MS=300000
PLANNING_SYNC_ENABLED=true
PLANNING_SYNC_INTERVAL_MS=600000

# Application mobile : copier ces valeurs dans apps/mobile/.env pour le développement local.
# Les variables EXPO_PUBLIC_ sont lues au bundling. Défaut : https://zevent-api.lofgplv.fr
EXPO_PUBLIC_API_BASE_URL=https://zevent-api.lofgplv.fr

# Clerk (Dashboard > API keys). Activez Google et Twitch dans SSO connections.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# Backend uniquement, ne jamais préfixer par EXPO_PUBLIC_.
CLERK_SECRET_KEY=sk_test_replace-me
# Optionnel : clé publique PEM pour valider les JWT sans appel réseau.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
