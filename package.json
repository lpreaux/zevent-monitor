{
  "name": "zevent-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "check": "turbo run lint typecheck test build",
    "start": "pnpm --filter @zevent-monitor/mobile dev",
    "start:expo-go": "pnpm --filter @zevent-monitor/mobile start:expo-go",
    "android": "pnpm --filter @zevent-monitor/mobile android",
    "ios": "pnpm --filter @zevent-monitor/mobile ios",
    "mobile:web": "pnpm --filter @zevent-monitor/mobile web",
    "mobile:doctor": "pnpm --filter @zevent-monitor/mobile doctor",
    "mobile:build:android": "pnpm --filter @zevent-monitor/mobile build:android",
    "api:dev": "pnpm --filter @zevent-monitor/api dev",
    "api:build": "pnpm --filter @zevent-monitor/api build",
    "api:test": "pnpm --filter @zevent-monitor/api test",
    "api:verify:deployment": "pnpm --filter @zevent-monitor/api verify:deployment",
    "content:import-history-2025": "node scripts/import-history-2025.mjs",
    "content:export-goals-2026": "node scripts/export-goals-2026.mjs",
    "content:export-planning-2026": "node scripts/export-planning-2026.mjs",
    "sources:spike-streamlabs": "node scripts/spike-streamlabs-history.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:measure-icon-nudge": "node scripts/measure-icon-nudge.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
